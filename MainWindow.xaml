<Window x:Class="TabScatter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TabScatter"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        Background="#111827">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#374151" />
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsEnabled" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#4B5563" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#6B7280" />
                    <Setter Property="Background" Value="#1F2937" />
                    <Setter Property="BorderBrush" Value="#374151" />
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="#374151" />
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Background" Value="#111827" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="TextElement.Foreground" Value="#D1D5DB" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#374151"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasHeader" Value="False">
                                <Setter TargetName="TabBorder" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1F2937" />
                                <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111827" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TabScatter"
                               Foreground="#22C55E"
                               FontSize="28"
                               FontWeight="Bold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="↻"
                        ToolTip="Refresh 4 Random Links"
                        AutomationProperties.Name="Refresh 4 Random Links"
                        Click="Refresh_Click"
                        FontSize="20"
                        Width="40"
                        Height="34"
                        Padding="0"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>
        <TabControl x:Name="AppTabs" Background="#111827">
            <TabItem Header="⌂" ToolTip="Link grid">
                <UniformGrid Rows="2" Columns="2">
                    <Border BorderBrush="#374151" BorderThickness="1" Margin="4" Background="#1F2937">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#111827">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="BackButton1" Content="←" ToolTip="Back" Tag="0"
                                                Click="NavigateBack_Click" IsEnabled="False" Margin="2" />
                                        <Button x:Name="ForwardButton1" Content="→" ToolTip="Forward" Tag="0"
                                                Click="NavigateForward_Click" IsEnabled="False" Margin="2" />
                                    </StackPanel>
                                    <Button x:Name="OpenButton1" Grid.Column="1" Content="New Tab" Tag="0"
                                            Click="OpenLink_Click" Margin="2" />
                                </Grid>
                            </Border>
                            <wv2:WebView2 x:Name="Browser1" />
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="#374151" BorderThickness="1" Margin="4" Background="#1F2937">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#111827">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="BackButton2" Content="←" ToolTip="Back" Tag="1"
                                                Click="NavigateBack_Click" IsEnabled="False" Margin="2" />
                                        <Button x:Name="ForwardButton2" Content="→" ToolTip="Forward" Tag="1"
                                                Click="NavigateForward_Click" IsEnabled="False" Margin="2" />
                                    </StackPanel>
                                    <Button x:Name="OpenButton2" Grid.Column="1" Content="New Tab" Tag="1"
                                            Click="OpenLink_Click" Margin="2" />
                                </Grid>
                            </Border>
                            <wv2:WebView2 x:Name="Browser2" />
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="#374151" BorderThickness="1" Margin="4" Background="#1F2937">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#111827">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="BackButton3" Content="←" ToolTip="Back" Tag="2"
                                                Click="NavigateBack_Click" IsEnabled="False" Margin="2" />
                                        <Button x:Name="ForwardButton3" Content="→" ToolTip="Forward" Tag="2"
                                                Click="NavigateForward_Click" IsEnabled="False" Margin="2" />
                                    </StackPanel>
                                    <Button x:Name="OpenButton3" Grid.Column="1" Content="New Tab" Tag="2"
                                            Click="OpenLink_Click" Margin="2" />
                                </Grid>
                            </Border>
                            <wv2:WebView2 x:Name="Browser3" />
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="#374151" BorderThickness="1" Margin="4" Background="#1F2937">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#111827">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="BackButton4" Content="←" ToolTip="Back" Tag="3"
                                                Click="NavigateBack_Click" IsEnabled="False" Margin="2" />
                                        <Button x:Name="ForwardButton4" Content="→" ToolTip="Forward" Tag="3"
                                                Click="NavigateForward_Click" IsEnabled="False" Margin="2" />
                                    </StackPanel>
                                    <Button x:Name="OpenButton4" Grid.Column="1" Content="New Tab" Tag="3"
                                            Click="OpenLink_Click" Margin="2" />
                                </Grid>
                            </Border>
                            <wv2:WebView2 x:Name="Browser4" />
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
